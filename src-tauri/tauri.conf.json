{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mumbo",
  "version": "0.1.0",
  "identifier": "com.citelao.mumbo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mumbo",
        "width": 700,
        "height": 500,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright (C) 2026 Benjamin Stolovitz & contributors",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1Mjk0MkNDMkYxMUVBMEUKUldRTzZoRXZ6RUlwSmNGVGZBaExVbVhFOFNTY05IV0I1VThGcEhFU2lQbnNYa1NxeUNvcmt1dTMK",
      "endpoints": [
        "https://github.com/citelao/mumbo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
